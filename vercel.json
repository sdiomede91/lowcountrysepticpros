{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.lowcountrysepticpros.com" }], "destination": "https://lowcountrysepticpros.com/:path*", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/(styles.css|favicon.svg)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=86400" }
    ] }
  ]
}
